# Image tag included in the offline release package.
IMAGE_VERSION=1.0.6

# Use a long random password. If it contains URL-reserved characters, percent-encode
# those characters only in DATABASE_URL while keeping POSTGRES_PASSWORD unchanged.
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://assets:replace-with-a-long-random-password@postgres:5432/assets?sslmode=disable

# Must exactly match the address employees use in their browser.
ALLOWED_ORIGIN=http://assets.company.local:9009
COOKIE_SECURE=false
BOOTSTRAP_ADMIN_USERNAME=admin

HTTP_PORT=9009
